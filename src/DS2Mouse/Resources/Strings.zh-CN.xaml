    <s:String x:Key="Mapping.MouseScroll">滚轮（垂直）</s:String>
    <s:String x:Key="Mapping.ArrowKeys">上下左右箭头</s:String>
    <s:String x:Key="Mapping.ToggleApp">切换映射启停</s:String>

    <!-- Action options for configurable mapping dropdowns. -->
    <s:String x:Key="Mapping.None">无</s:String>
    <s:String x:Key="Mapping.LeftClick">左键单击</s:String>
    <s:String x:Key="Mapping.RightClick">右键单击</s:String>
    <s:String x:Key="Mapping.MiddleClick">中键单击</s:String>
