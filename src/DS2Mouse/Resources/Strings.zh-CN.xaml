    <s:String x:Key="Mapping.Escape">Esc</s:String>
    <s:String x:Key="Mapping.Space">空格</s:String>
    <s:String x:Key="Mapping.Tab">Tab</s:String>
    <s:String x:Key="Mapping.Ctrl">Ctrl</s:String>
    <s:String x:Key="Mapping.Shift">Shift</s:String>
    <s:String x:Key="Mapping.Alt">Alt</s:String>

    <s:String x:Key="Lang.Chinese">中文</s:String>
    <s:String x:Key="Lang.English">English</s:String>

    <s:String x:Key="Toast.Title">Pad2Mouse</s:String>
    <s:String x:Key="Toast.Enabled">映射已启用</s:String>
    <s:String x:Key="Toast.Disabled">映射已禁用</s:String>

