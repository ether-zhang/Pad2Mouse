<Window x:Class="DS2Mouse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource Window.Title}"
        Icon="pack://application:,,,/Resources/tray.ico"
        Height="760" Width="980" MinHeight="620" MinWidth="820"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource ForegroundBrush}"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="ControllerModeToggleStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushNormal}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ModeBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModeBorder" Property="Background" Value="{DynamicResource ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeBorder" Property="Background" Value="{DynamicResource ControlPressed}"/>
                                <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ControllerHotspotStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#D0202A33"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="HotspotBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="24">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HotspotBorder" Property="Background" Value="#EE34495A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="HotspotBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="HotspotBorder" Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SensitivityPresetStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushNormal}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinHeight" Value="72"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="PresetBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PresetBorder" Property="Background" Value="{DynamicResource ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PresetBorder" Property="Background" Value="{DynamicResource ControlPressed}"/>
                                <Setter TargetName="PresetBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <!-- CaptionHeight defines the drag region; UseAeroCaptionButtons=False
             hides the system min/max/close so our custom buttons own the
             top-right. The default CornerRadius=0 + GlassFrameThickness lets
             Windows 11 apply its native rounded corners + drop shadow. -->
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Custom title bar ===== -->
        <Grid Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Window.Title}"
                       Margin="14,0,0,0" VerticalAlignment="Center"
                       FontWeight="SemiBold"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <!-- Glyphs from Segoe MDL2 Assets, matching the system caption buttons.
                     MaxBtn's content is swapped to the restore glyph at runtime when
                     WindowState becomes Maximized; see OnWindowStateChanged. -->
                <Button x:Name="MinBtn"
                        Style="{StaticResource TitleBarButton}"
                        Content="&#xE921;" Click="OnMinClick"/>
                <Button x:Name="MaxBtn"
                        Style="{StaticResource TitleBarButton}"
                        Content="&#xE922;" Click="OnMaxClick"/>
                <Button x:Name="CloseBtn"
                        Style="{StaticResource TitleBarCloseButton}"
                        Content="&#xE8BB;" Click="OnCloseClick"/>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1" Margin="8,0,8,8">
        <!-- ===== MAIN TAB ===== -->
        <TabItem Header="{DynamicResource Tab.Main}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12">

                <!-- Status row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Status.Connection}" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ConnText" VerticalAlignment="Center"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" x:Name="EnableCheck" Content="{DynamicResource Action.EnableMapping}" IsChecked="True"
                              Checked="OnEnableToggle" Unchecked="OnEnableToggle"/>
                </Grid>

                <Separator Margin="0,12,0,12"/>

                <!-- Controller-first mapping editor. The Viewbox scales image and
                     hotspots together, keeping hit targets aligned at any window size. -->
                <Border Background="{DynamicResource PanelBackground}" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="2,0,2,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Section.Mapping}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource Mapping.SelectHint}"
                                           Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ToggleButton x:Name="PsViewButton" Content="PlayStation" IsChecked="True"
                                              Style="{StaticResource ControllerModeToggleStyle}"
                                              Click="OnControllerModeClick" Tag="PlayStation"/>
                                <ToggleButton x:Name="XboxViewButton" Content="Xbox" Margin="6,0,0,0"
                                              Style="{StaticResource ControllerModeToggleStyle}"
                                              Click="OnControllerModeClick" Tag="Xbox"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="260"/>
                            </Grid.ColumnDefinitions>

                            <Grid MinHeight="350" Margin="0,0,14,0" ClipToBounds="True">
                                <Viewbox x:Name="PsControllerView" Stretch="Uniform">
                                    <Grid Width="768" Height="512">
                                        <Image Source="pack://application:,,,/Resources/outline_1.png" Stretch="Fill"/>
                                        <Canvas x:Name="PsHotspotCanvas">
                                            <ToggleButton Content="L2" Tag="L2" Width="64" Height="34" Canvas.Left="137" Canvas.Top="52"
                                                          Style="{StaticResource ControllerHotspotStyle}" Click="OnMappingHotspotClick"/>
                                            <ToggleButton Content="R2" Tag="R2" Width="64" Height="34" Canvas.Left="568" Canvas.Top="52"
                                                          Style="{StaticResource ControllerHotspotStyle}" Click="OnMappingHotspotClick"/>
                                            <ToggleButton Content="L3" Tag="L3" Width="54" Height="54" Canvas.Left="247" Canvas.Top="248"
                                                          Style="{StaticResource ControllerHotspotStyle}" Click="OnMappingHotspotClick"/>
                                            <ToggleButton Content="R3" Tag="R3" Width="54" Height="54" Canvas.Left="466" Canvas.Top="248"
                                                          Style="{StaticResource ControllerHotspotStyle}" Click="OnMappingHotspotClick"/>
                                            <ToggleButton Content="△" Tag="Triangle" Width="38" Height="38" Canvas.Left="571" Canvas.Top="126"
                                                          Style="{StaticResource ControllerHotspotStyle}" Click="OnMappingHotspotClick"/>
                                            <ToggleButton Content="□" Tag="Square" Width="38" Height="38" Canvas.Left="523" Canvas.Top="172"
                                                          Style="{StaticResource ControllerHotspotStyle}" Click="OnMappingHotspotClick"/>
                                            <ToggleButton Content="○" Tag="Circle" Width="38" Height="38" Canvas.Left="618" Canvas.Top="172"
                                                          Style="{StaticResource ControllerHotspotStyle}" Click="OnMappingHotspotClick"/>
                                            <ToggleButton Content="✕" Tag="Cross" Width="38" Height="38" Canvas.Left="571" Canvas.Top="216"
                                                          Style="{StaticResource ControllerHotspotStyle}" Click="OnMappingHotspotClick"/>
                                        </Canvas>
                                    </Grid>
                                </Viewbox>

                                <Viewbox x:Name="XboxControllerView" Stretch="Uniform" Visibility="Collapsed">
                                    <Grid Width="768" Height="512">
                                        <Image Source="pack://application:,,,/Resources/outline_2.png" Stretch="Fill"/>
                                        <Canvas x:Name="XboxHotspotCanvas">
                                            <ToggleButton Content="LT" Tag="L2" Width="64" Height="34" Canvas.Left="194" Canvas.Top="52"
                                                          Style="{StaticResource ControllerHotspotStyle}" Click="OnMappingHotspotClick"/>
                                            <ToggleButton Content="RT" Tag="R2" Width="64" Height="34" Canvas.Left="493" Canvas.Top="52"
                                                          Style="{StaticResource ControllerHotspotStyle}" Click="OnMappingHotspotClick"/>
                                            <ToggleButton Content="LSB" Tag="L3" Width="58" Height="58" Canvas.Left="211" Canvas.Top="163"
                                                          Style="{StaticResource ControllerHotspotStyle}" Click="OnMappingHotspotClick"/>
                                            <ToggleButton Content="RSB" Tag="R3" Width="58" Height="58" Canvas.Left="436" Canvas.Top="243"
                                                          Style="{StaticResource ControllerHotspotStyle}" Click="OnMappingHotspotClick"/>
                                            <ToggleButton Content="Y" Tag="Triangle" Width="38" Height="38" Canvas.Left="496" Canvas.Top="139"
                                                          Style="{StaticResource ControllerHotspotStyle}" Click="OnMappingHotspotClick"/>
                                            <ToggleButton Content="X" Tag="Square" Width="38" Height="38" Canvas.Left="459" Canvas.Top="171"
                                                          Style="{StaticResource ControllerHotspotStyle}" Click="OnMappingHotspotClick"/>
                                            <ToggleButton Content="B" Tag="Circle" Width="38" Height="38" Canvas.Left="533" Canvas.Top="171"
                                                          Style="{StaticResource ControllerHotspotStyle}" Click="OnMappingHotspotClick"/>
                                            <ToggleButton Content="A" Tag="Cross" Width="38" Height="38" Canvas.Left="496" Canvas.Top="205"
                                                          Style="{StaticResource ControllerHotspotStyle}" Click="OnMappingHotspotClick"/>
                                        </Canvas>
                                    </Grid>
                                </Viewbox>
                            </Grid>

                            <Border Grid.Column="1" Background="{DynamicResource ControlBackground}"
                                    BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1"
                                    CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Mapping.SelectedButton}"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <TextBlock x:Name="SelectedMappingName" Text="✕" FontSize="26" FontWeight="SemiBold" Margin="0,2,0,10"/>
                                    <ComboBox x:Name="MappingActionCombo" Tag="Cross" Padding="6"
                                              SelectionChanged="OnMappingChanged"/>

                                    <Separator Margin="0,14,0,12"/>
                                    <TextBlock Text="{DynamicResource Mapping.Fixed}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{DynamicResource Mapping.LeftStick}" Margin="0,2,10,2"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{DynamicResource Mapping.MouseMove}" Margin="0,2"/>
                                        <TextBlock Grid.Row="1" Text="{DynamicResource Mapping.RightStick}" Margin="0,2,10,2"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{DynamicResource Mapping.MouseScroll}" Margin="0,2"/>
                                        <TextBlock Grid.Row="2" Text="{DynamicResource Mapping.DPad}" Margin="0,2,10,2"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{DynamicResource Mapping.ArrowKeys}" Margin="0,2"/>
                                        <TextBlock x:Name="FixedToggleComboLabel" Grid.Row="3" Text="L3 + R3" Margin="0,2,10,2"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{DynamicResource Mapping.ToggleApp}" Margin="0,2"/>
                                        <TextBlock x:Name="FixedKeyboardComboLabel" Grid.Row="4" Text="L1 + R1" Margin="0,2,10,2"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{DynamicResource Mapping.OnScreenKeyboard}" TextWrapping="Wrap" Margin="0,2"/>
                                        <TextBlock x:Name="FixedCenterComboLabel" Grid.Row="5" Text="Create + Options" Margin="0,2,10,2"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{DynamicResource Mapping.CenterCursor}" TextWrapping="Wrap" Margin="0,2"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Sensitivity presets stay compact; detailed sliders only appear
                     after the user explicitly chooses Custom. -->
                <Border Background="{DynamicResource PanelBackground}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Section.Sensitivity}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource Sensitivity.Hint}" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2,0,10"/>
                        <UniformGrid Columns="4">
                            <ToggleButton x:Name="PrecisePresetButton" Tag="Precise" Style="{StaticResource SensitivityPresetStyle}"
                                          Click="OnSensitivityPresetClick">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Preset.Precise}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{DynamicResource Preset.PreciseHint}" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="BalancedPresetButton" Tag="Balanced" Style="{StaticResource SensitivityPresetStyle}"
                                          Click="OnSensitivityPresetClick">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Preset.Balanced}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{DynamicResource Preset.BalancedHint}" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="FastPresetButton" Tag="Fast" Style="{StaticResource SensitivityPresetStyle}"
                                          Click="OnSensitivityPresetClick">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Preset.Fast}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{DynamicResource Preset.FastHint}" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="CustomPresetButton" Tag="Custom" Margin="0"
                                          Style="{StaticResource SensitivityPresetStyle}" Click="OnSensitivityPresetClick">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Preset.Custom}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{DynamicResource Preset.CustomHint}" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </ToggleButton>
                        </UniformGrid>

                        <Border x:Name="CustomSensitivityPanel" Visibility="Collapsed"
                                Background="{DynamicResource ControlBackground}" CornerRadius="8" Padding="14" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Section.LeftStick}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Field.Sensitivity}" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" x:Name="SensSlider" Minimum="2" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True"
                                                Value="12" ValueChanged="OnSensChanged" Margin="8,0"/>
                                        <TextBlock Grid.Column="2" x:Name="SensVal" Text="12" VerticalAlignment="Center" TextAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Field.Deadzone}" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" x:Name="DzSlider" Minimum="0" Maximum="0.4" Value="0.10" ValueChanged="OnDzChanged" Margin="8,0"/>
                                        <TextBlock Grid.Column="2" x:Name="DzVal" Text="0.10" VerticalAlignment="Center" TextAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Field.AccelMax}" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" x:Name="AccelMaxSlider" Minimum="1.0" Maximum="5.0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                Value="2.5" ValueChanged="OnAccelMaxChanged" Margin="8,0"/>
                                        <TextBlock Grid.Column="2" x:Name="AccelMaxVal" Text="2.5" VerticalAlignment="Center" TextAlignment="Right"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Field.AccelRamp}" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" x:Name="AccelRampSlider" Minimum="0.2" Maximum="3.0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                Value="1.0" ValueChanged="OnAccelRampChanged" Margin="8,0"/>
                                        <TextBlock Grid.Column="2" x:Name="AccelRampVal" Text="1.0" VerticalAlignment="Center" TextAlignment="Right"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource Section.RightStick}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Field.ScrollSpeed}" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" x:Name="ScrollSlider" Minimum="1" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
                                                Value="8" ValueChanged="OnScrollChanged" Margin="8,0"/>
                                        <TextBlock Grid.Column="2" x:Name="ScrollVal" Text="8" VerticalAlignment="Center" TextAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Field.AccelMax}" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" x:Name="ScrollAccelMaxSlider" Minimum="1.0" Maximum="5.0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                Value="2.5" ValueChanged="OnScrollAccelMaxChanged" Margin="8,0"/>
                                        <TextBlock Grid.Column="2" x:Name="ScrollAccelMaxVal" Text="2.5" VerticalAlignment="Center" TextAlignment="Right"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Field.AccelRamp}" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" x:Name="ScrollAccelRampSlider" Minimum="0.2" Maximum="3.0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                Value="1.0" ValueChanged="OnScrollAccelRampChanged" Margin="8,0"/>
                                        <TextBlock Grid.Column="2" x:Name="ScrollAccelRampVal" Text="1.0" VerticalAlignment="Center" TextAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Whitelist -->
                <StackPanel Margin="0,12,0,8">
                    <TextBlock Text="{DynamicResource Section.Whitelist}"
                               FontWeight="Bold" TextWrapping="Wrap"/>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="WhitelistInput" Padding="4" KeyDown="OnWhitelistInputKeyDown"/>
                        <Button Grid.Column="1" Content="{DynamicResource Action.Add}" Padding="10,4" Margin="6,0,0,0" Click="OnWhitelistAdd"/>
                        <Button Grid.Column="2" Content="{DynamicResource Action.RemoveSelected}" Padding="10,4" Margin="6,0,0,0" Click="OnWhitelistRemove"/>
                    </Grid>
                    <ListBox x:Name="WhitelistBox" Height="100" Margin="0,4,0,0"/>
                    <TextBlock x:Name="GuardStatusText" Margin="0,6,0,0"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ===== SETTINGS TAB ===== -->
        <TabItem Header="{DynamicResource Tab.Settings}">
            <StackPanel Margin="12">
                <Grid Margin="0,4,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Field.Language}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" x:Name="LanguageCombo" SelectionChanged="OnLanguageChanged" Padding="4">
                        <ComboBoxItem Tag="zh-CN">
                            <TextBlock Text="{DynamicResource Lang.Chinese}"/>
                        </ComboBoxItem>
                        <ComboBoxItem Tag="en">
                            <TextBlock Text="{DynamicResource Lang.English}"/>
                        </ComboBoxItem>
                    </ComboBox>
                </Grid>

                <CheckBox x:Name="NotifyCheck" Content="{DynamicResource Field.Notifications}"
                          Margin="0,4,0,0"
                          Checked="OnNotifyToggle" Unchecked="OnNotifyToggle"/>

                <CheckBox x:Name="AutoStartCheck" Content="{DynamicResource Field.AutoStart}"
                          Margin="0,8,0,0"
                          Checked="OnAutoStartToggle" Unchecked="OnAutoStartToggle"/>
            </StackPanel>
        </TabItem>
    </TabControl>
    </Grid>
</Window>
