<Window x:Class="DS2Mouse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Window.Title}"
        Icon="pack://application:,,,/Resources/tray.ico"
        Height="600" Width="580" MinHeight="500" MinWidth="500"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">
    <TabControl Margin="8">
        <!-- ===== MAIN TAB ===== -->
        <TabItem Header="{DynamicResource Tab.Main}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12">

                <!-- Status row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Status.Connection}" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ConnText" VerticalAlignment="Center"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" x:Name="EnableCheck" Content="{DynamicResource Action.EnableMapping}" IsChecked="True"
                              Checked="OnEnableToggle" Unchecked="OnEnableToggle"/>
                </Grid>

                <Separator Margin="0,12,0,12"/>

                <!-- Button mapping reference -->
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="{DynamicResource Section.Mapping}" FontWeight="Bold" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="0,2,0,2"/>
                            </Style>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" FontFamily="Consolas" Text="{DynamicResource Mapping.LeftStick}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{DynamicResource Mapping.MouseMove}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" FontFamily="Consolas" Text="{DynamicResource Mapping.RightStick}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{DynamicResource Mapping.MouseScroll}"/>

                        <TextBlock x:Name="LblR2" Grid.Row="2" Grid.Column="0" FontFamily="Consolas" Text="R2"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="MapR2Combo" Tag="R2"
                                  SelectionChanged="OnMappingChanged" Padding="4" Margin="0,1,0,1"/>

                        <TextBlock x:Name="LblL2" Grid.Row="3" Grid.Column="0" FontFamily="Consolas" Text="L2"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="MapL2Combo" Tag="L2"
                                  SelectionChanged="OnMappingChanged" Padding="4" Margin="0,1,0,1"/>

                        <TextBlock x:Name="LblCross" Grid.Row="4" Grid.Column="0" FontFamily="Consolas" Text="✕"/>
                        <ComboBox Grid.Row="4" Grid.Column="1" x:Name="MapCrossCombo" Tag="Cross"
                                  SelectionChanged="OnMappingChanged" Padding="4" Margin="0,1,0,1"/>

                        <TextBlock x:Name="LblCircle" Grid.Row="5" Grid.Column="0" FontFamily="Consolas" Text="○"/>
                        <ComboBox Grid.Row="5" Grid.Column="1" x:Name="MapCircleCombo" Tag="Circle"
                                  SelectionChanged="OnMappingChanged" Padding="4" Margin="0,1,0,1"/>

                        <TextBlock x:Name="LblSquare" Grid.Row="6" Grid.Column="0" FontFamily="Consolas" Text="□"/>
                        <ComboBox Grid.Row="6" Grid.Column="1" x:Name="MapSquareCombo" Tag="Square"
                                  SelectionChanged="OnMappingChanged" Padding="4" Margin="0,1,0,1"/>

                        <TextBlock x:Name="LblTriangle" Grid.Row="7" Grid.Column="0" FontFamily="Consolas" Text="△"/>
                        <ComboBox Grid.Row="7" Grid.Column="1" x:Name="MapTriangleCombo" Tag="Triangle"
                                  SelectionChanged="OnMappingChanged" Padding="4" Margin="0,1,0,1"/>

                        <TextBlock Grid.Row="8" Grid.Column="0" FontFamily="Consolas" Text="{DynamicResource Mapping.DPad}"/>
                        <TextBlock Grid.Row="8" Grid.Column="1" Text="{DynamicResource Mapping.ArrowKeys}"/>

                        <TextBlock x:Name="LblL3R3" Grid.Row="9" Grid.Column="0" FontFamily="Consolas" Text="L3 + R3"/>
                        <TextBlock Grid.Row="9" Grid.Column="1" Text="{DynamicResource Mapping.ToggleApp}"/>

                        <TextBlock x:Name="LblL1R1" Grid.Row="10" Grid.Column="0" FontFamily="Consolas" Text="L1 + R1"/>
                        <TextBlock Grid.Row="10" Grid.Column="1" Text="{DynamicResource Mapping.OnScreenKeyboard}"/>
                    </Grid>
                </StackPanel>

                <Separator Margin="0,4,0,12"/>

                <!-- Sensitivity controls -->
                <StackPanel>
                    <TextBlock Text="{DynamicResource Section.LeftStick}" FontWeight="Bold" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Field.Sensitivity}" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" x:Name="SensSlider" Minimum="2" Maximum="40"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="12" ValueChanged="OnSensChanged" Margin="8,0"/>
                        <TextBlock Grid.Column="2" x:Name="SensVal" Text="12" VerticalAlignment="Center" TextAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Field.Deadzone}" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" x:Name="DzSlider" Minimum="0" Maximum="0.4"
                                Value="0.10" ValueChanged="OnDzChanged" Margin="8,0"/>
                        <TextBlock Grid.Column="2" x:Name="DzVal" Text="0.10" VerticalAlignment="Center" TextAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Field.AccelMax}" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" x:Name="AccelMaxSlider" Minimum="1.0" Maximum="5.0"
                                TickFrequency="0.1" IsSnapToTickEnabled="True"
                                Value="2.5" ValueChanged="OnAccelMaxChanged" Margin="8,0"/>
                        <TextBlock Grid.Column="2" x:Name="AccelMaxVal" Text="2.5" VerticalAlignment="Center" TextAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Field.AccelRamp}" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" x:Name="AccelRampSlider" Minimum="0.2" Maximum="3.0"
                                TickFrequency="0.1" IsSnapToTickEnabled="True"
                                Value="1.0" ValueChanged="OnAccelRampChanged" Margin="8,0"/>
                        <TextBlock Grid.Column="2" x:Name="AccelRampVal" Text="1.0" VerticalAlignment="Center" TextAlignment="Right"/>
                    </Grid>

                    <TextBlock Text="{DynamicResource Section.RightStick}" FontWeight="Bold" Margin="0,8,0,4"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Field.ScrollSpeed}" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" x:Name="ScrollSlider" Minimum="1" Maximum="30"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="8" ValueChanged="OnScrollChanged" Margin="8,0"/>
                        <TextBlock Grid.Column="2" x:Name="ScrollVal" Text="8" VerticalAlignment="Center" TextAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Field.AccelMax}" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" x:Name="ScrollAccelMaxSlider" Minimum="1.0" Maximum="5.0"
                                TickFrequency="0.1" IsSnapToTickEnabled="True"
                                Value="2.5" ValueChanged="OnScrollAccelMaxChanged" Margin="8,0"/>
                        <TextBlock Grid.Column="2" x:Name="ScrollAccelMaxVal" Text="2.5" VerticalAlignment="Center" TextAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Field.AccelRamp}" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" x:Name="ScrollAccelRampSlider" Minimum="0.2" Maximum="3.0"
                                TickFrequency="0.1" IsSnapToTickEnabled="True"
                                Value="1.0" ValueChanged="OnScrollAccelRampChanged" Margin="8,0"/>
                        <TextBlock Grid.Column="2" x:Name="ScrollAccelRampVal" Text="1.0" VerticalAlignment="Center" TextAlignment="Right"/>
                    </Grid>
                </StackPanel>

                <!-- Whitelist -->
                <StackPanel Margin="0,12,0,8">
                    <TextBlock Text="{DynamicResource Section.Whitelist}"
                               FontWeight="Bold" TextWrapping="Wrap"/>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="WhitelistInput" Padding="4" KeyDown="OnWhitelistInputKeyDown"/>
                        <Button Grid.Column="1" Content="{DynamicResource Action.Add}" Padding="10,4" Margin="6,0,0,0" Click="OnWhitelistAdd"/>
                        <Button Grid.Column="2" Content="{DynamicResource Action.RemoveSelected}" Padding="10,4" Margin="6,0,0,0" Click="OnWhitelistRemove"/>
                    </Grid>
                    <ListBox x:Name="WhitelistBox" Height="100" Margin="0,4,0,0"/>
                    <TextBlock x:Name="GuardStatusText" Margin="0,6,0,0" Foreground="DimGray"/>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ===== SETTINGS TAB ===== -->
        <TabItem Header="{DynamicResource Tab.Settings}">
            <StackPanel Margin="12">
                <Grid Margin="0,4,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Field.Language}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" x:Name="LanguageCombo" SelectionChanged="OnLanguageChanged" Padding="4">
                        <ComboBoxItem Tag="zh-CN">
                            <TextBlock Text="{DynamicResource Lang.Chinese}"/>
                        </ComboBoxItem>
                        <ComboBoxItem Tag="en">
                            <TextBlock Text="{DynamicResource Lang.English}"/>
                        </ComboBoxItem>
                    </ComboBox>
                </Grid>

                <CheckBox x:Name="NotifyCheck" Content="{DynamicResource Field.Notifications}"
                          Margin="0,4,0,0"
                          Checked="OnNotifyToggle" Unchecked="OnNotifyToggle"/>

                <CheckBox x:Name="AutoStartCheck" Content="{DynamicResource Field.AutoStart}"
                          Margin="0,8,0,0"
                          Checked="OnAutoStartToggle" Unchecked="OnAutoStartToggle"/>
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
