<Window x:Class="DS2Mouse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DS2Mouse" Height="380" Width="540"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="Connection:" FontWeight="Bold" Margin="0,0,8,0"/>
            <TextBlock x:Name="ConnText" Text="Disconnected"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="Mapping:" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <CheckBox x:Name="EnableCheck" Content="Enabled" IsChecked="True" VerticalAlignment="Center"
                      Checked="OnEnableToggle" Unchecked="OnEnableToggle"/>
            <TextBlock Margin="16,0,0,0" Foreground="Gray" VerticalAlignment="Center"
                       Text="(PS button on controller toggles too)"/>
        </StackPanel>

        <Separator Grid.Row="2" Margin="0,12,0,12"/>

        <StackPanel Grid.Row="3">
            <TextBlock Text="Live state (debug)" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock x:Name="StickText" FontFamily="Consolas" Text="L:(0.00, 0.00)  R:(0.00, 0.00)"/>
            <TextBlock x:Name="TrigText"  FontFamily="Consolas" Text="L2:0.00  R2:0.00" Margin="0,4,0,0"/>
            <TextBlock x:Name="BtnText"   FontFamily="Consolas" Text="Buttons: None" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
    </Grid>
</Window>
