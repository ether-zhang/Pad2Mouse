<Window x:Class="DS2Mouse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DS2Mouse" Height="560" Width="560" MinHeight="500" MinWidth="480"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Status row -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Connection:" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="ConnText" Text="Disconnected" VerticalAlignment="Center"/>
            </StackPanel>
            <CheckBox Grid.Column="1" x:Name="EnableCheck" Content="Enable mapping" IsChecked="True"
                      Checked="OnEnableToggle" Unchecked="OnEnableToggle"/>
        </Grid>

        <Separator Grid.Row="1" Margin="0,12,0,12"/>

        <!-- Sensitivity controls -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="Left stick — mouse" FontWeight="Bold" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Sensitivity" VerticalAlignment="Center"/>
                <Slider Grid.Column="1" x:Name="SensSlider" Minimum="2" Maximum="40"
                        TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="12" ValueChanged="OnSensChanged" Margin="8,0"/>
                <TextBlock Grid.Column="2" x:Name="SensVal" Text="12" VerticalAlignment="Center" TextAlignment="Right"/>
            </Grid>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Deadzone" VerticalAlignment="Center"/>
                <Slider Grid.Column="1" x:Name="DzSlider" Minimum="0" Maximum="0.4"
                        Value="0.10" ValueChanged="OnDzChanged" Margin="8,0"/>
                <TextBlock Grid.Column="2" x:Name="DzVal" Text="0.10" VerticalAlignment="Center" TextAlignment="Right"/>
            </Grid>

            <TextBlock Text="Right stick — scroll" FontWeight="Bold" Margin="0,8,0,4"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Speed (notch/s)" VerticalAlignment="Center"/>
                <Slider Grid.Column="1" x:Name="ScrollSlider" Minimum="1" Maximum="30"
                        TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="8" ValueChanged="OnScrollChanged" Margin="8,0"/>
                <TextBlock Grid.Column="2" x:Name="ScrollVal" Text="8" VerticalAlignment="Center" TextAlignment="Right"/>
            </Grid>
        </StackPanel>

        <!-- Whitelist -->
        <StackPanel Grid.Row="3" Margin="0,12,0,8">
            <TextBlock Text="Fullscreen whitelist (process names — auto-disabled in fullscreen UNLESS listed)"
                       FontWeight="Bold" TextWrapping="Wrap"/>
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="WhitelistInput" Padding="4" KeyDown="OnWhitelistInputKeyDown"/>
                <Button Grid.Column="1" Content="Add" Padding="10,4" Margin="6,0,0,0" Click="OnWhitelistAdd"/>
                <Button Grid.Column="2" Content="Remove selected" Padding="10,4" Margin="6,0,0,0" Click="OnWhitelistRemove"/>
            </Grid>
            <ListBox x:Name="WhitelistBox" Height="100" Margin="0,4,0,0"/>
            <TextBlock x:Name="GuardStatusText" Margin="0,6,0,0" Foreground="DimGray"
                       Text="Foreground: —    Fullscreen: no    Suppressed: no"/>
        </StackPanel>

        <!-- Debug -->
        <StackPanel Grid.Row="4" Margin="0,4,0,0">
            <TextBlock Text="Live state" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock x:Name="StickText" FontFamily="Consolas" Text="L:(0.00, 0.00)  R:(0.00, 0.00)"/>
            <TextBlock x:Name="TrigText"  FontFamily="Consolas" Text="L2:0.00  R2:0.00" Margin="0,2,0,0"/>
            <TextBlock x:Name="BtnText"   FontFamily="Consolas" Text="Buttons: None" TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>
    </Grid>
</Window>
