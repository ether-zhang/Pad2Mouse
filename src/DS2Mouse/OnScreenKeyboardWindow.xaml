<Window x:Class="DS2Mouse.OnScreenKeyboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pad2Mouse Keyboard"
        ShowActivated="False"
        Topmost="True"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        Background="Transparent"
        FontFamily="Segoe UI"
        Focusable="False">
    <Window.Resources>
        <Style x:Key="KeyBtn" TargetType="Button">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#80FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WideBtn" TargetType="Button" BasedOn="{StaticResource KeyBtn}">
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Border x:Name="DragArea" Background="#C0202020" CornerRadius="10" Padding="6"
            MouseLeftButtonDown="OnDragAreaPressed">
        <StackPanel HorizontalAlignment="Center">

            <!-- Title bar: drag handle + close button -->
            <Grid Margin="0,0,0,2" Height="22">
                <Button Style="{StaticResource KeyBtn}" Width="22" Height="22"
                        Content="✕" FontSize="10"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="OnCloseClick"/>
            </Grid>

            <!-- Row 1: digits + backspace. Labels swap to !@#$%^&*() when Shift is latched. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource KeyBtn}" Content="1" Tag="0x31" Click="OnKeyClick"/>
                <Button Style="{StaticResource KeyBtn}" Content="2" Tag="0x32" Click="OnKeyClick"/>
                <Button Style="{StaticResource KeyBtn}" Content="3" Tag="0x33" Click="OnKeyClick"/>
                <Button Style="{StaticResource KeyBtn}" Content="4" Tag="0x34" Click="OnKeyClick"/>
                <Button Style="{StaticResource KeyBtn}" Content="5" Tag="0x35" Click="OnKeyClick"/>
                <Button Style="{StaticResource KeyBtn}" Content="6" Tag="0x36" Click="OnKeyClick"/>
                <Button Style="{StaticResource KeyBtn}" Content="7" Tag="0x37" Click="OnKeyClick"/>
                <Button Style="{StaticResource KeyBtn}" Content="8" Tag="0x38" Click="OnKeyClick"/>
                <Button Style="{StaticResource KeyBtn}" Content="9" Tag="0x39" Click="OnKeyClick"/>
                <Button Style="{StaticResource KeyBtn}" Content="0" Tag="0x30" Click="OnKeyClick"/>
                <Button Style="{StaticResource WideBtn}" Width="56" Content="⌫" Tag="0x08" Click="OnKeyClick"/>
            </StackPanel>

            <!-- Row 2: top alpha. Shown lowercase by default, uppercase when Shift is latched. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource KeyBtn}" Content="q" Tag="0x51" Click="OnKeyClick"/>
                <Button Style="{StaticResource KeyBtn}" Content="w" Tag="0x57" Click="OnKeyClick"/>
                <Button Style="{StaticResource KeyBtn}" Content="e" Tag="0x45" Click="OnKeyClick"/>
                <Button Style="{StaticResource KeyBtn}" Content="r" Tag="0x52" Click="OnKeyClick"/>
                <Button Style="{StaticResource KeyBtn}" Content="t" Tag="0x54" Click="OnKeyClick"/>
                <Button Style="{StaticResource KeyBtn}" Content="y" Tag="0x59" Click="OnKeyClick"/>
                <Button Style="{StaticResource KeyBtn}" Content="u" Tag="0x55" Click="OnKeyClick"/>
                <Button Style="{StaticResource KeyBtn}" Content="i" Tag="0x49" Click="OnKeyClick"/>
                <Button Style="{StaticResource KeyBtn}" Content="o" Tag="0x4F" Click="OnKeyClick"/>
                <Button Style="{StaticResource KeyBtn}" Content="p" Tag="0x50" Click="OnKeyClick"/>
            </StackPanel>

            <!-- Row 3: middle alpha + enter -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource KeyBtn}" Content="a" Tag="0x41" Click="OnKeyClick"/>
                <Button Style="{StaticResource KeyBtn}" Content="s" Tag="0x53" Click="OnKeyClick"/>
                <Button Style="{StaticResource KeyBtn}" Content="d" Tag="0x44" Click="OnKeyClick"/>
                <Button Style="{StaticResource KeyBtn}" Content="f" Tag="0x46" Click="OnKeyClick"/>
                <Button Style="{StaticResource KeyBtn}" Content="g" Tag="0x47" Click="OnKeyClick"/>
                <Button Style="{StaticResource KeyBtn}" Content="h" Tag="0x48" Click="OnKeyClick"/>
                <Button Style="{StaticResource KeyBtn}" Content="j" Tag="0x4A" Click="OnKeyClick"/>
                <Button Style="{StaticResource KeyBtn}" Content="k" Tag="0x4B" Click="OnKeyClick"/>
                <Button Style="{StaticResource KeyBtn}" Content="l" Tag="0x4C" Click="OnKeyClick"/>
                <Button Style="{StaticResource WideBtn}" Width="64" Content="↵" Tag="0x0D" Click="OnKeyClick"/>
            </StackPanel>

            <!-- Row 4: Shift + bottom alpha + comma + period -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="ShiftBtn" Style="{StaticResource WideBtn}" Width="60"
                        Content="⇧" Tag="SHIFT" Click="OnShiftClick"/>
                <Button Style="{StaticResource KeyBtn}" Content="z" Tag="0x5A" Click="OnKeyClick"/>
                <Button Style="{StaticResource KeyBtn}" Content="x" Tag="0x58" Click="OnKeyClick"/>
                <Button Style="{StaticResource KeyBtn}" Content="c" Tag="0x43" Click="OnKeyClick"/>
                <Button Style="{StaticResource KeyBtn}" Content="v" Tag="0x56" Click="OnKeyClick"/>
                <Button Style="{StaticResource KeyBtn}" Content="b" Tag="0x42" Click="OnKeyClick"/>
                <Button Style="{StaticResource KeyBtn}" Content="n" Tag="0x4E" Click="OnKeyClick"/>
                <Button Style="{StaticResource KeyBtn}" Content="m" Tag="0x4D" Click="OnKeyClick"/>
                <Button Style="{StaticResource KeyBtn}" Content="," Tag="0xBC" Click="OnKeyClick"/>
                <Button Style="{StaticResource KeyBtn}" Content="." Tag="0xBE" Click="OnKeyClick"/>
            </StackPanel>

            <!-- Row 5: Ctrl + Tab + Space + Esc -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="CtrlBtn" Style="{StaticResource WideBtn}" Width="60"
                        Content="Ctrl" Tag="CTRL" Click="OnCtrlClick"/>
                <Button Style="{StaticResource WideBtn}" Width="44" Content="Tab" Tag="0x09" Click="OnKeyClick"/>
                <Button Style="{StaticResource WideBtn}" Width="220" Content="Space" Tag="0x20" Click="OnKeyClick"/>
                <Button Style="{StaticResource WideBtn}" Width="44" Content="Esc" Tag="0x1B" Click="OnKeyClick"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
