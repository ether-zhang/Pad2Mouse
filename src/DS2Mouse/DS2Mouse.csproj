<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\tray.ico</ApplicationIcon>
    <AssemblyName>Pad2Mouse</AssemblyName>
    <RootNamespace>DS2Mouse</RootNamespace>
    <Version>1.0.0</Version>
    <PublishSingleFile Condition="'$(Configuration)' == 'Release'">true</PublishSingleFile>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <!-- Strip developer-machine paths from the published binary. Without this
       the PE RSDS debug directory bakes in the absolute build path of
       Pad2Mouse.pdb, visible to anyone running `strings` on the shipped exe.
       Embedded PDB keeps crash-dump symbols available while
       DeterministicSourcePaths rewrites source paths to /_/. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="HidSharp" Version="2.6.4" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\tray.ico" />
    <Resource Include="Resources\outline_1.png" />
    <Resource Include="Resources\outline_2.png" />
  </ItemGroup>

</Project>
